      "strokeColor": "#5C2D91",
      "backgroundColor": "#E8DAEF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-message"
    },
    {
      "type": "rectangle",
      "x": 1360,
      "y": 550,
      "width": 480,
      "height": 230,
      "strokeColor": "#F7630C",
      "backgroundColor": "#FFF4CE",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-content"
    },
    {
      "type": "rectangle",
      "x": 1360,
      "y": 850,
      "width": 480,
      "height": 140,
      "strokeColor": "#495057",
      "backgroundColor": "#dee2e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-annotation"
    },
    {
      "type": "rectangle",
      "x": 40,
      "y": 1100,
      "width": 680,
      "height": 250,
      "strokeColor": "#0078D4",
      "backgroundColor": "#CFE4FA",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-azure-config"
    },
    {
      "type": "rectangle",
      "x": 900,
      "y": 1100,
      "width": 940,
      "height": 250,
      "strokeColor": "#D13438",
      "backgroundColor": "#FDE7E9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-azure-result"
    },
    {
      "type": "rectangle",
      "x": 40,
      "y": 1420,
      "width": 1800,
      "height": 100,
      "strokeColor": "#495057",
      "backgroundColor": "#dee2e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "id": "box-rust-legend"
    },
    {
      "type": "text",
      "x": 50,
      "y": 25,
      "width": 1500,
      "height": 80,
      "text": "Rust MAF: the mental map",
      "fontSize": 32,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-title"
    },
    {
      "type": "text",
      "x": 50,
      "y": 110,
      "width": 1750,
      "height": 80,
      "text": "Current learning subset. Green = agent logic, blue = client/config, teal = response, purple = message, orange = content.\nThe Azure JSON mappers at the bottom are separate: they do not implement ChatClient or send HTTP.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-subtitle"
    },
    {
      "type": "text",
      "x": 60,
      "y": 240,
      "width": 460,
      "height": 190,
      "text": "Agent<C: ChatClient>\nCoordinates one turn\nChecks input; creates user Message\nSends history + instructions\nStores reply messages in session",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-agent"
    },
    {
      "type": "text",
      "x": 720,
      "y": 240,
      "width": 460,
      "height": 190,
      "text": "ChatClient (trait)\nget_response(messages, instructions)\nReturns Result<ChatResponse, ClientError>\nFakeChatClient implements this today",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-chatclient"
    },
    {
      "type": "text",
      "x": 1380,
      "y": 240,
      "width": 440,
      "height": 170,
      "text": "ChatResponse\nmessages: Vec<Message>\nresponse_id: Option<String>\ntext() joins message text",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-response"
    },
    {
      "type": "text",
      "x": 60,
      "y": 570,
      "width": 460,
      "height": 150,
      "text": "AgentSession (memory)\nid: String\nhistory: Vec<Message>\nCan save and restore JSON",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-session"
    },
    {
      "type": "text",
      "x": 720,
      "y": 570,
      "width": 460,
      "height": 200,
      "text": "Message (one turn)\nrole: String\ncontents: Vec<Content>\nauthor_name?, message_id?\nnew() turns strings into Text",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-message"
    },
    {
      "type": "text",
      "x": 1380,
      "y": 570,
      "width": 440,
      "height": 200,
      "text": "Content (enum)\nText\nFunctionCall\nFunctionResult\nTextReasoning\nText may carry annotations",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-content"
    },
    {
      "type": "text",
      "x": 1380,
      "y": 870,
      "width": 440,
      "height": 100,
      "text": "Annotation (enum)\nCurrent subset: citation\nOptional title and URL",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-annotation"
    },
    {
      "type": "text",
      "x": 60,
      "y": 1020,
      "width": 1750,
      "height": 70,
      "text": "Separate Azure request and response mapping (not connected to ChatClient)",
      "fontSize": 22,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-azure-heading"
    },
    {
      "type": "text",
      "x": 60,
      "y": 1120,
      "width": 640,
      "height": 210,
      "text": "AzureOpenAIConfig\nowns endpoint + deployment; new() rejects empties\nbuild_request_body: Message -> request JSON\nparse_response: response JSON -> ChatResponse\nOffline JSON mapping only; no ChatClient\nNo HTTP request is sent",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-azure-config"
    },
    {
      "type": "text",
      "x": 920,
      "y": 1120,
      "width": 900,
      "height": 210,
      "text": "Request: model + input + optional instructions\nUser Text -> input_text; assistant Text -> output_text + []\nRequest errors: empty input, role, content, annotations\nResponse: output_text -> assistant Message; preserve IDs\nEmpty output -> empty assistant Message\nResponse rejects unsupported content; errors are String",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-azure-result"
    },
    {
      "type": "text",
      "x": 60,
      "y": 1440,
      "width": 1760,
      "height": 70,
      "text": "Rust shorthand: Vec<T> = ordered list   |   Option<T> = maybe a value   |   Result<T, E> = success or error\n&[Message] = borrowed, read-only message list   |   Start tracing at Agent::run, then follow one arrow.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "text-rust-legend"
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  }
}
